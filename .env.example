# ==============================================================================
# BIZLENS - ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Application & Environment
APP_ENV=development
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_key_in_production
PORT=8000
FRONTEND_PORT=5173

# Database & Storage
# In development: sqlite:///./bizlens.db | In production: postgresql://user:pass@localhost:5432/bizlens
DATABASE_URL=sqlite:///./bizlens.db
STORAGE_ROOT=./storage

# Ingestion & Upload Security Limits
MAX_UPLOAD_MB=50
MAX_ROWS=1000000
MAX_COLS=200
MAX_SHEETS=20
MAX_CELL_CHARS=10000
MAX_DECOMPRESSED_MB=200
MAX_COMPRESSION_RATIO=10

# Authentication & Session Security
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
LOGIN_MAX_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Rate Limiting
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_UPLOAD=5/minute
RATE_LIMIT_AI=20/minute

# CORS & Networking
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI & Gemini Configuration (Official Google GenAI SDK)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_S=30
GEMINI_DAILY_TOKEN_BUDGET=1000000
AI_CACHE_TTL_S=86400

# Live Data Connectors & Security (SSRF Allowlist)
LIVE_ALLOWED_HOSTS=api.frankfurter.app,api.open-meteo.com
LIVE_CACHE_TTL_S=3600

# Fiscal Calendar & Locale Defaults
FISCAL_YEAR_START_MONTH_DEFAULT=4
DEFAULT_CURRENCY=INR

# Observability (Optional)
SENTRY_DSN=

# Feature Flags (CSV of enabled keys)
FEATURE_FLAGS=
